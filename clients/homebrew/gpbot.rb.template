class Gpbot < Formula
  desc "HTTPS-backed GPBot operator CLI"
  homepage "https://finalboss-engine.com"
  version "VERSION"
  license "Proprietary"

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/CODOLIE_ORG/GPBOT_CLI_RELEASE_REPO/releases/download/gpbot-cli-v#{version}/gpbot-macos-arm64.pyz"
      sha256 "MACOS_ARM64_SHA256"
    else
      url "https://github.com/CODOLIE_ORG/GPBOT_CLI_RELEASE_REPO/releases/download/gpbot-cli-v#{version}/gpbot-macos-x86_64.pyz"
      sha256 "MACOS_X86_64_SHA256"
    end
  end

  depends_on "python@3.12"

  def install
    pyz = Dir["gpbot-*.pyz"].first
    libexec.install pyz => "gpbot.pyz"

    (bin/"gpbot").write <<~EOS
      #!/bin/bash
      exec "#{Formula["python@3.12"].opt_bin}/python3" "#{libexec}/gpbot.pyz" "$@"
    EOS
  end

  test do
    assert_match "GPBot remote operator CLI", shell_output("#{bin}/gpbot --help")
    assert_match "Authenticate with a GPBot API key", shell_output("#{bin}/gpbot login --help")
  end
end

